# =============================================================================
# Ortam Değişkenleri (Kopyalayıp ".env" olarak kaydedin, ASLA commit etmeyin!)
#   cp .env.example .env
# =============================================================================

# --- LLM Sağlayıcısı: OpenAI veya Anthropic ---
# İkisinden biri doluysa sistem o sağlayıcıyı kullanır; ikisi de boşsa
# Advisor uç noktası net bir 503 hata döndürür (CRUD uçları LLM'siz çalışır).
# Gerçek API anahtarınızı buraya girin (kendi ortamınızda üretilmemiştir).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Veritabanı ---
# Geliştirme/test: SQLite (async sürücü aiosqlite)
DATABASE_URL=sqlite+aiosqlite:///./advisor.db
# Docker/PostgreSQL örneği:
# DATABASE_URL=postgresql+asyncpg://advisor:advisor@db:5432/advisor

# --- Uygulama ---
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
