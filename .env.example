# =============================================================================
# Ortam değişkenleri — kopyalayıp ".env" olarak kaydedin. ASLA commit etmeyin.
# Arama sırası: <proje>/.env  →  <proje>/../.env  (gerçek ortam değişkeni önceliklidir)
# Tüm değerler boş bırakılabilir: anahtar yoksa uygulama DEMO modunda çalışır.
# =============================================================================

# --- LLM (OpenAI-uyumlu; varsayılan: DeepSeek V4 Flash @ Evren) ---------------
# Anahtar takma adları (ilk dolu kazanır): LLM_API_KEY, DEEPSEEK_API_KEY, EVREN_API_KEY, OPENAI_API_KEY
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# auto | live | demo
LLM_MODE=
LLM_PROVIDER=
LLM_TIMEOUT_SECONDS=
LLM_MAX_RETRIES=
LLM_TEMPERATURE=
LLM_MAX_TOKENS=
# true (varsayılan): DeepSeek V4 muhakeme modunu kapatır (daha hızlı yanıt)
LLM_DISABLE_THINKING=
ANTHROPIC_API_KEY=

# --- Veritabanı ------------------------------------------------------------------
# Boşsa SQLite (./advisor.db). Docker Compose Postgres URL'sini kendisi kurar.
DATABASE_URL=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# --- Güvenlik ------------------------------------------------------------------------
JWT_SECRET=
PII_ENCRYPTION_KEY=
ADMIN_USERNAME=
ADMIN_PASSWORD=
CORS_ORIGINS=

# --- Veri ------------------------------------------------------------------------------
# auto (canlı → snapshot) | live | snapshot
DATA_MODE=
EVDS_API_KEY=

# --- Uygulama ------------------------------------------------------------------------------
APP_ENV=
LOG_LEVEL=
LOG_JSON=
SEED_DEMO=
SCHEDULER_ENABLED=
